# Vite frontend environment variables
# Only variables prefixed with VITE_ are exposed to the browser.
# Variables not prefixed are for the backend API at runtime (server-side only).

# Server (development) API base URL
# Maps to: http-common.ts (fallback if VITE_API_URL is not set)
VITE_API_URL=http://localhost:8080

# Dev server port (for Vite dev server, default 5173)
VITE_DEV_PORT=5173

# Production API base URL (production fallback)
VITE_API_URL_PROD=https://projeto.com.br
